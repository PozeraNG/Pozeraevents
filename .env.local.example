# Copy this file to .env.local (git-ignored) and fill in real values for local dev.
# On Vercel, set the same variables under Project Settings → Environment Variables.

# Resend (https://resend.com) sends the Book Consultation form's submissions
# (src/app/api/consultation/route.ts) to pozeraevents@gmail.com. Sign up free, then
# create an API key at https://resend.com/api-keys and paste it below.
RESEND_API_KEY=

# Optional: who the email appears to be from. Until you verify your own domain with
# Resend (https://resend.com/domains), leave this unset — it defaults to Resend's
# shared "onboarding@resend.dev" sending address, which works immediately with no
# setup. Once a domain is verified, set this to something like:
# RESEND_FROM_EMAIL="Pozera Events Website <notifications@pozeraevents.com>"
RESEND_FROM_EMAIL=

# Academy enrollment WhatsApp number is confirmed and hardcoded directly in
# src/components/AcademyCTA.tsx (+234 814 611 7487). Other WhatsApp CTAs on the site
# use the same number, hardcoded at their call sites.
